# Copy to .env in the directory from which you run node (Node 24+).
# Running a launch-*.mjs file deliberately signs, spends funds and publishes.
PRIVATE_KEY=
LAUNCH_API_URL=

# Optional: blank uses the SDK official Robinhood chain-4663 mainnet RPC.
RPC_URL=
# Optional ERC404 NFT metadata base URI that you actually host; blank means empty URI.
NFT_BASE_URI=

# Optional local tightening restrictions. Blank/unset means unknown, not refused.
# Nitro protocol compute caps and poster budgeting are read natively at the pinned block.
# EXAMPLE_CHAIN_GAS_CAP=
# EXAMPLE_RPC_GAS_CAP=
# EXAMPLE_ACCOUNT_GAS_CAP=
# EXAMPLE_MAX_CALLDATA_BYTES=
# EXAMPLE_HEADROOM_BPS=1500
