# Copy to .env in the directory from which you run node (Node 24+).
# Running a launch-*.mjs file deliberately signs, spends funds and publishes.
PRIVATE_KEY=
LAUNCH_API_URL=

# Optional: blank uses the SDK official Robinhood chain-4663 mainnet RPC.
RPC_URL=
# Optional: separate owned loopback Anvil used only for SDK controlled simulation.
# Blank selects the actual RPC native eth_simulateV1 backend.
SIMULATION_RPC_URL=
# Optional ERC404 NFT metadata base URI that you actually host; blank means empty URI.
NFT_BASE_URI=

# Optional EXAMPLE ceilings, NOT verified provider/account limits.
# Chain cap is also bounded by every observed block gas limit.
# EXAMPLE_CHAIN_GAS_CAP=16000000
# EXAMPLE_RPC_GAS_CAP=16000000
# EXAMPLE_ACCOUNT_GAS_CAP=16000000
# EXAMPLE_MAX_CALLDATA_BYTES=131072
# EXAMPLE_HEADROOM_BPS=1000
