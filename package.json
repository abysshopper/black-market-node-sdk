{
  "name": "@black-market/sdk",
  "version": "0.5.0",
  "description": "Canonical TypeScript SDK for Black Market on Robinhood Chain (reviewed multi-market launches, Abyss DEX, lending).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abysshopper/black-market-node-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "assets"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "examples": "pnpm build && node examples/quickstart.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke:launch": "pnpm build && node examples/smoke-launch.mjs",
    "prepublishOnly": "pnpm build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && node --test test/*.test.mjs",
    "test:api": "pnpm build && node --test test/integration/launch-api.read.test.mjs",
    "test:api:write": "pnpm build && node --test test/integration/launch-api.sessions.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "black-market",
    "abyss",
    "robinhood-chain",
    "defi",
    "viem"
  ]
}
